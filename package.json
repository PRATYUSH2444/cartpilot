{
  "name": "agent-commerce-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Commerce Gateway (CartPilot) — Policy-Controlled AI Shopping Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6"
    }
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "seed": "npm run seed --workspace=@cartpilot/api",
    "seed:clean": "npm run seed:clean --workspace=@cartpilot/api"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
