# ==============================================================================
# CartPilot Monorepo — Global Environment Template
# ==============================================================================

# Backend API Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas / Local)
MONGODB_URI=mongodb://127.0.0.1:27017/cartpilot_dev

# Authentication Secrets (Min 32 characters each)
JWT_ACCESS_SECRET=cartpilot_dev_access_secret_super_secure_32bytes_min
JWT_REFRESH_SECRET=cartpilot_dev_refresh_secret_super_secure_32bytes_min

# Real AI Provider (gemini or openai)
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=sk-proj-YourOpenAIApiKeyHere
OPENAI_MODEL=gpt-4o-mini

# Transactional Email via HTTPS API (Render free tier blocks SMTP 25/465/587)
RESEND_API_KEY=re_YourResendKeyHere
RESEND_FROM_EMAIL=CartPilot <onboarding@resend.dev>
BREVO_API_KEY=xkeysib-YourBrevoApiKeyHere

# Support Help Desk Delivery
SUPPORT_TO_EMAIL=praka.extra28@gmail.com
SUPPORT_FROM_EMAIL=CartPilot Support <onboarding@resend.dev>

# Clerk Identity & Webhook Integration (https://clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_YourClerkPublishableKeyHere
CLERK_SECRET_KEY=sk_test_YourClerkSecretKeyHere
CLERK_WEBHOOK_SECRET=whsec_YourClerkWebhookSecretHere
CLERK_SMS_WEBHOOK_SECRET=whsec_your_clerk_sms_webhook_secret_here

# SMS Carrier (Twilio — https://twilio.com)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MG_your_messaging_service_sid_here

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_YourKeyId
RAZORPAY_KEY_SECRET=YourKeySecret
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecret

# Maps & Geocoding
GOOGLE_MAPS_API_KEY=

# Web Frontend (Public Vite Variables)
VITE_API_URL=http://localhost:5000/api/v1
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YourClerkPublishableKeyHere
VITE_PUBLIC_SUPPORT_EMAIL=support@cartpilot.app
