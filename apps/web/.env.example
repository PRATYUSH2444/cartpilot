# ==============================================================================
# CartPilot Web Frontend — Environment Configuration Template
# ==============================================================================

# Render Production API endpoint or localhost in development
# In Production on Vercel: https://cartpilot-api.onrender.com/api/v1
# In Development: http://localhost:5000/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# Clerk Identity Configuration (https://clerk.com)
# ------------------------------------------------------------------------------
# Publishable Key from Clerk Dashboard -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YourClerkPublishableKeyHere

# ------------------------------------------------------------------------------
# Customer Support & Help Desk Configuration
# ------------------------------------------------------------------------------
# Admin support email address where contact requests & customer queries are routed
VITE_ADMIN_SUPPORT_EMAIL=prakash.pratyush2444@gmail.com

# Optional: Google Form URL for feedback & direct customer inquiry submissions
VITE_SUPPORT_GOOGLE_FORM_URL=
