{
  "name": "@cartpilot/api",
  "version": "0.1.0",
  "private": true,
  "description": "CartPilot API Backend — Node.js, Express, TypeScript, Mongoose",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "seed": "tsx src/database/seed.ts",
    "seed:clean": "tsx src/database/seed.ts --clean",
    "provision:admin": "tsx src/scripts/provision-admin.ts",
    "db:reset": "tsx src/scripts/reset-dev-database.ts",
    "lint": "eslint src --ext .ts"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.7.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.8.1",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^8.57.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3"
  }
}
