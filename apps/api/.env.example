# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas / Local fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/cartpilot_dev

# Authentication Secrets
JWT_ACCESS_SECRET=cartpilot_dev_access_secret_super_secure_32bytes_min
JWT_REFRESH_SECRET=cartpilot_dev_refresh_secret_super_secure_32bytes_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# AI Agent Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_TIMEOUT_MS=15000
