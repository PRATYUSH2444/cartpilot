# ==============================================================================
# CartPilot API — Production Environment Configuration Template
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Primary Database (MongoDB Atlas in Production / Local URI in Dev)
# ------------------------------------------------------------------------------
# Production (MongoDB Atlas connection string):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cartpilot?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cartpilot_dev

# ------------------------------------------------------------------------------
# Cryptographic Authentication Secrets (Min. 32 characters each)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=cartpilot_dev_access_secret_super_secure_32bytes_min
JWT_REFRESH_SECRET=cartpilot_dev_refresh_secret_super_secure_32bytes_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Clerk Identity & Webhook Integration (https://clerk.com)
# ------------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_YourClerkPublishableKeyHere
CLERK_SECRET_KEY=sk_test_YourClerkSecretKeyHere
CLERK_WEBHOOK_SECRET=whsec_YourClerkWebhookSecretHere
ADMIN_CLERK_USER_ID=user_2YourMasterAdminClerkIdHere

# ------------------------------------------------------------------------------
# Generative AI & Autonomous LLM Engine (Google Gemini or OpenAI)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
AI_TIMEOUT_MS=20000

# Google Gemini (Get key at https://aistudio.google.com)
GEMINI_API_KEY=AIzaSyYourActualKeyHere
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Alternative provider, get key at https://platform.openai.com)
OPENAI_API_KEY=sk-proj-YourActualOpenAIKeyHere
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Transactional Email (Resend — https://resend.com)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_YourResendApiKeyHere
RESEND_FROM_EMAIL=CartPilot <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# SMS / Carrier OTP Dispatch (Twilio — https://twilio.com)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay — https://razorpay.com)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# ------------------------------------------------------------------------------
# Maps, Geocoding & Distance Calculation
# ------------------------------------------------------------------------------
# Optional Google Maps Key. If omitted, CartPilot automatically uses
# OpenStreetMap Nominatim with zero configuration required.
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# Inventory Sweeper Interval (Default: 60000ms / 1 min)
# ------------------------------------------------------------------------------
RESERVATION_SWEEPER_INTERVAL_MS=60000
